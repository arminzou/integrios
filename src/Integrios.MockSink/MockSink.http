@baseUrl = {{SINK_BASE}}

###
# MockSink helper flow
#
# Use this file alongside Admin.http and Ingestion.http.
# It lets you push the downstream sink into failure or slow modes so you can
# observe worker retries, replay, and recovery.

###
# Step 0 - Health check
GET {{baseUrl}}/health

###
# Step 1 - Force the standard ERP sink to fail
# Worker deliveries will retry and may eventually dead-letter.
PUT {{baseUrl}}/control/acme-erp

Content-Type: application/json

{
  "mode": "fail"
}

###
# Step 2 - Force the standard ERP sink to respond slowly
PUT {{baseUrl}}/control/acme-erp

Content-Type: application/json

{
  "mode": "slow",
  "delayMs": 2000
}

###
# Step 3 - Reset the standard ERP sink back to default
DELETE {{baseUrl}}/control/acme-erp

###
# Step 4 - Post a delivery manually
# Normally the worker does this after subscription fanout.
POST {{baseUrl}}/sink/acme-erp

Content-Type: application/json

{
  "test": "manual delivery"
}

###
# Cleanup - reset sinks touched by the manual walkthrough before rerunning
DELETE {{baseUrl}}/control/acme-erp

###
DELETE {{baseUrl}}/control/acme-erp-auth

###
DELETE {{baseUrl}}/control/acme-open-no-auth

###
DELETE {{baseUrl}}/control/acme-source

###
DELETE {{baseUrl}}/control/acme-source-only-destination

### Query captured receipts without exposing header values
GET {{baseUrl}}/receipts/acme-erp

### Assert a captured header value without echoing it in the response
POST {{baseUrl}}/receipts/acme-erp/assert-headers
Content-Type: application/json

{
  "headers": {
    "X-Example-Header": "expected-value"
  }
}

### Reset captured receipts
DELETE {{baseUrl}}/receipts/acme-erp
