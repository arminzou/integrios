@baseUrl = {{SINK_BASE}}

###
# Health check
GET {{baseUrl}}/health

###
# Force acme-erp sink to fail (Worker deliveries will retry)
PUT {{baseUrl}}/control/acme-erp
Content-Type: application/json

{ "mode": "fail" }

###
# Force acme-erp sink to respond slowly (2 s delay)
PUT {{baseUrl}}/control/acme-erp
Content-Type: application/json

{ "mode": "slow", "delayMs": 2000 }

###
# Reset acme-erp sink back to default (succeed)
DELETE {{baseUrl}}/control/acme-erp

###
# Post a delivery manually (normally done by Worker)
POST {{baseUrl}}/sink/acme-erp
Content-Type: application/json

{ "test": "manual delivery" }
