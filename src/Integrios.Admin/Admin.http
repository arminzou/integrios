@baseUrl = {{ADMIN_BASE_URL}}
@ingestionBaseUrl = {{INGESTION_BASE_URL}}
@mocksinkAdmin = {{MOCKSINK_ADMIN_BASE_URL}}
@sinkBase = {{SINK_BASE}}
@operatorKey = Authorization: OperatorKey global_operator_key:operator_bootstrap_secret

# Progressive Operator dashboard seed
#
# Run Shared setup once, then run each journey from top to bottom. Every journey creates one Topic,
# one Source, one Destination, and one Subscription using the shared HTTP Connector and Tenant.
# The Tenant API key is shared by the Tenant, but only Event API intake uses it.
#
# Use a clean database: rerunning Shared setup returns 409 for the existing Tenant slug.
# SINK_BASE must be reachable by Worker. Compose normally uses http://mocksink:8080.

###
# Shared setup — reset recorded deliveries
DELETE {{mocksinkAdmin}}/__admin/requests

###
POST {{mocksinkAdmin}}/__admin/mappings/reset

###
# Shared setup — apply one bidirectional Connector for all three journeys
# @name applyHttpConnector
PUT {{baseUrl}}/admin/connectors/http/versions/1
{{operatorKey}}
Content-Type: application/json

< ../../examples/connectors/http.json

###
@connectorId = {{applyHttpConnector.response.body.$.connector.id}}

###
# Shared setup — create one Tenant
# @name createNorthwind
POST {{baseUrl}}/admin/tenants
{{operatorKey}}
Content-Type: application/json

{
  "slug": "northwind-retail",
  "name": "Northwind Retail",
  "environment": "development",
  "description": "Progressive UI journeys for Event API, webhook, and Azure Service Bus intake."
}

###
@tenantId = {{createNorthwind.response.body.$.id}}

###
# Shared setup — create the one Tenant API key reused by Event API journeys
# @name createTenantApiKey
POST {{baseUrl}}/admin/tenants/{{tenantId}}/tenant-api-keys
{{operatorKey}}
Content-Type: application/json

{
  "name": "northwind-ingestion",
  "description": "Shared Event API credential for the Northwind Tenant.",
  "expires_at": null
}

###
@tenantApiToken = {{createTenantApiKey.response.body.$.token}}

###############################################################################
# Journey 1 — Event API -> Orders Topic -> ERP Destination
#
# Dashboard path:
# HTTP Connector -> Orders Topic -> Orders Event API Source
#                -> ERP Destination <- Orders to ERP Subscription
###############################################################################

###
# Journey 1.1 — create the Topic
# @name createOrdersTopic
POST {{baseUrl}}/admin/tenants/{{tenantId}}/topics
{{operatorKey}}
Content-Type: application/json

{
  "key": "orders",
  "name": "Orders",
  "description": "Orders accepted through the Event API."
}

###
# Journey 1.2 — create the Event API Source
# @name createOrdersEventApiSource
POST {{baseUrl}}/admin/tenants/{{tenantId}}/sources
{{operatorKey}}
Content-Type: application/json

{
  "connector_id": "{{connectorId}}",
  "topic_id": "{{createOrdersTopic.response.body.$.id}}",
  "name": "Orders Event API",
  "type": "event_api",
  "configuration": {},
  "verification": null,
  "input_requirements": null,
  "mapping": null,
  "event_identity_rule": null
}

###
# Journey 1.3 — create the HTTP Destination
# @name createErpDestination
POST {{baseUrl}}/admin/tenants/{{tenantId}}/destinations
{{operatorKey}}
Content-Type: application/json

{
  "connector_id": "{{connectorId}}",
  "name": "orders-erp",
  "configuration": {
    "base_uri": "{{sinkBase}}/sink/orders-erp"
  },
  "authentication": null,
  "environment": "development",
  "description": "ERP endpoint for placed orders."
}

###
# Journey 1.4 — route placed orders to the ERP
# @name createOrdersSubscription
POST {{baseUrl}}/admin/tenants/{{tenantId}}/topics/{{createOrdersTopic.response.body.$.id}}/subscriptions
{{operatorKey}}
Content-Type: application/json

{
  "name": "orders-to-erp",
  "match_rules": { "event_type": "order.placed" },
  "destination_id": "{{createErpDestination.response.body.$.id}}",
  "mapping": null,
  "http_delivery": null,
  "http_success": null,
  "order_index": 0,
  "description": "Deliver every placed order to the ERP."
}

###
# Journey 1.5 — send one Event with the shared Tenant API key
# @name sendPlacedOrder
POST {{ingestionBaseUrl}}/events?source_id={{createOrdersEventApiSource.response.body.$.id}}
Authorization: Bearer {{tenantApiToken}}
Content-Type: application/json

{
  "event_type": "order.placed",
  "source_event_id": "order-1001",
  "payload": {
    "order_id": "1001",
    "total": 119.50,
    "currency": "USD"
  }
}

###
# Journey 1.6 — rerun after Worker delivers; the response should contain one request
POST {{mocksinkAdmin}}/__admin/requests/find
Content-Type: application/json

{
  "method": "POST",
  "urlPath": "/sink/orders-erp"
}

###############################################################################
# Journey 2 — HMAC Webhook -> Storefront Topic -> Audit Destination
#
# Dashboard path:
# HTTP Connector -> Storefront Topic -> Storefront Webhook Source
#                -> Audit Destination <- Webhook to Audit Subscription
#
# Resource authoring needs only the secret reference name. Sending the webhook also requires the
# Ingestion Source secret named storefront_webhook_hmac and a signature calculated over the exact
# request body. Keep the value outside this repository.
###############################################################################

###
# Journey 2.1 — create the Topic
# @name createStorefrontTopic
POST {{baseUrl}}/admin/tenants/{{tenantId}}/topics
{{operatorKey}}
Content-Type: application/json

{
  "key": "storefront-webhooks",
  "name": "Storefront webhooks",
  "description": "Verified callbacks received from the storefront."
}

###
# Journey 2.2 — create the HMAC-verified Webhook Source
# @name createStorefrontWebhookSource
POST {{baseUrl}}/admin/tenants/{{tenantId}}/sources
{{operatorKey}}
Content-Type: application/json

{
  "connector_id": "{{connectorId}}",
  "topic_id": "{{createStorefrontTopic.response.body.$.id}}",
  "name": "Storefront webhook",
  "type": "webhook",
  "configuration": {},
  "verification": {
    "scheme": "hmac_sha256",
    "config": {},
    "secret_refs": {
      "secret": "storefront_webhook_hmac"
    }
  },
  "input_requirements": {
    "type": "object",
    "properties": {
      "delivery_id": { "type": "string" },
      "result": { "type": "string" }
    },
    "required": ["delivery_id", "result"],
    "additionalProperties": false
  },
  "mapping": {
    "engine": "jsonata",
    "version": "1",
    "expression": "{\"event_type\":\"storefront.webhook.received\",\"payload\":$}"
  },
  "event_identity_rule": {
    "kind": "header",
    "value": "X-Storefront-Delivery",
    "allow_missing": false
  }
}

###
# Journey 2.3 — create the HTTP Destination
# @name createAuditDestination
POST {{baseUrl}}/admin/tenants/{{tenantId}}/destinations
{{operatorKey}}
Content-Type: application/json

{
  "connector_id": "{{connectorId}}",
  "name": "webhook-audit",
  "configuration": {
    "base_uri": "{{sinkBase}}/sink/webhook-audit"
  },
  "authentication": null,
  "environment": "development",
  "description": "Audit endpoint for normalized storefront callbacks."
}

###
# Journey 2.4 — route normalized callbacks to the audit endpoint
# @name createWebhookSubscription
POST {{baseUrl}}/admin/tenants/{{tenantId}}/topics/{{createStorefrontTopic.response.body.$.id}}/subscriptions
{{operatorKey}}
Content-Type: application/json

{
  "name": "storefront-webhooks-to-audit",
  "match_rules": { "event_type": "storefront.webhook.received" },
  "destination_id": "{{createAuditDestination.response.body.$.id}}",
  "mapping": null,
  "http_delivery": null,
  "http_success": null,
  "order_index": 0,
  "description": "Deliver normalized storefront callbacks to the audit endpoint."
}

###
# Journey 2.5 — optional runtime step
# Set WEBHOOK_SIGNATURE in your private REST Client environment to sha256=<hex HMAC> for the exact
# compact body below, after mounting storefront_webhook_hmac for Ingestion.
POST {{ingestionBaseUrl}}/webhooks/{{createStorefrontWebhookSource.response.body.$.configuration.callback_id}}
X-Hub-Signature-256: {{WEBHOOK_SIGNATURE}}
X-Storefront-Delivery: storefront-delivery-1001
Content-Type: application/json

{"delivery_id":"storefront-delivery-1001","result":"accepted"}

###
# Journey 2.6 — rerun after Worker delivers; the response should contain one request
POST {{mocksinkAdmin}}/__admin/requests/find
Content-Type: application/json

{
  "method": "POST",
  "urlPath": "/sink/webhook-audit"
}

###############################################################################
# Journey 3 — Azure Service Bus -> Warehouse Topic -> WMS Destination
#
# Dashboard path:
# HTTP Connector -> Warehouse Topic -> Azure Service Bus Source
#                -> WMS Destination <- Warehouse Receipts Subscription
#
# Start the queue-demo Compose profile and mount the Ingestion Source secret named dev_service_bus
# before creating the Source. Admin.http cannot write secret files or publish broker messages.
###############################################################################

###
# Journey 3.1 — create the Topic
# @name createWarehouseTopic
POST {{baseUrl}}/admin/tenants/{{tenantId}}/topics
{{operatorKey}}
Content-Type: application/json

{
  "key": "warehouse-receipts",
  "name": "Warehouse receipts",
  "description": "Receipt messages consumed from Azure Service Bus."
}

###
# Journey 3.2 — create the Azure Service Bus Source
# @name createWarehouseBrokerSource
POST {{baseUrl}}/admin/tenants/{{tenantId}}/sources
{{operatorKey}}
Content-Type: application/json

{
  "connector_id": "{{connectorId}}",
  "topic_id": "{{createWarehouseTopic.response.body.$.id}}",
  "name": "Warehouse receipts",
  "type": "broker",
  "configuration": {
    "transport": "azure_service_bus",
    "authentication": {
      "scheme": "connection_string",
      "secret_ref": "dev_service_bus"
    },
    "transport_config": {
      "namespace": "servicebus-emulator",
      "queue_name": "ui-demo"
    }
  },
  "verification": null,
  "input_requirements": null,
  "mapping": null,
  "event_identity_rule": {
    "kind": "message_id",
    "value": "message_id",
    "allow_missing": false
  }
}

###
# Journey 3.3 — create the HTTP Destination
# @name createWmsDestination
POST {{baseUrl}}/admin/tenants/{{tenantId}}/destinations
{{operatorKey}}
Content-Type: application/json

{
  "connector_id": "{{connectorId}}",
  "name": "warehouse-wms",
  "configuration": {
    "base_uri": "{{sinkBase}}/sink/warehouse-wms"
  },
  "authentication": null,
  "environment": "development",
  "description": "Warehouse management endpoint for receipt messages."
}

###
# Journey 3.4 — route receipts to the WMS
# @name createWarehouseSubscription
POST {{baseUrl}}/admin/tenants/{{tenantId}}/topics/{{createWarehouseTopic.response.body.$.id}}/subscriptions
{{operatorKey}}
Content-Type: application/json

{
  "name": "warehouse-receipts-to-wms",
  "match_rules": { "event_type": "warehouse.receipt.recorded" },
  "destination_id": "{{createWmsDestination.response.body.$.id}}",
  "mapping": null,
  "http_delivery": null,
  "http_success": null,
  "order_index": 0,
  "description": "Deliver warehouse receipts to the WMS."
}

###
# Journey 3.5 — publish outside REST Client
# Pipe this JSON into scripts/send-service-bus.cs using your private emulator connection string:
# {"event_type":"warehouse.receipt.recorded","source_event_id":"receipt-1001","payload":{"receipt_id":"1001","status":"received"}}

###
# Journey 3.6 — rerun after the broker receiver and Worker finish; expect one request
POST {{mocksinkAdmin}}/__admin/requests/find
Content-Type: application/json

{
  "method": "POST",
  "urlPath": "/sink/warehouse-wms"
}
