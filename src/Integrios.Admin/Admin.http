@baseUrl = {{ADMIN_BASE_URL}}
@ingestionBaseUrl = {{INGESTION_BASE_URL}}
@mocksinkAdmin = {{MOCKSINK_ADMIN_BASE_URL}}
@operatorKey = Authorization: OperatorKey global_operator_key:operator_bootstrap_secret

# Sink base URL:
# - use http://mocksink:8080 when the Worker resolves a Destination's base_uri inside the Compose
#   network; that is the value written into every Destination below
# - MOCKSINK_ADMIN_BASE_URL is the host-side WireMock admin used to reset mappings and stub a
#   failing Destination, e.g. http://localhost:5054
@sinkBase = {{SINK_BASE}}

###
# Single-tenant seed for exercising the Operator dashboard
#
# Run top to bottom against a running Compose stack. It creates one fully-configured Tenant with
# Destinations, Topics, Sources, and Subscriptions in active, disabled, and paused states, then
# drives Events through Ingestion so the dashboard shows delivered, unrouted, and dead-lettered work.
#
# scripts/seed-dev-data.sh seeds this same Northwind Retail data plus smaller Tenants. Unlike the
# shell script, this file cannot:
# - wipe tenant-scoped tables first, so rerunning without a fresh database returns 409 on the Tenant
#   slug (truncate as the script does, or start clean)
# - write secrets/source/northwind-retail/dev_service_bus, which the broker Source below needs
# - publish the warehouse receipt to the Service Bus emulator or wait for the failing Delivery to
#   dead-letter

###
# Step 1 - Reset WireMock so this run starts with no recorded deliveries or stubs
DELETE {{mocksinkAdmin}}/__admin/requests

###
POST {{mocksinkAdmin}}/__admin/mappings/reset

###
# Step 2 - Apply the generic HTTP Connector
# Bootstrap creates only the deployment-wide OperatorKey. The Connector identity is generated when
# the Operator applies its manifest through Admin.
# @name applyHttpConnector
PUT {{baseUrl}}/admin/connectors/http/versions/1
{{operatorKey}}
Content-Type: application/json

< ../../examples/connectors/http.json

###
@connectorId = {{applyHttpConnector.response.body.$.connector.id}}

###
# Step 3 - Create the Tenant
# @name createNorthwind
POST {{baseUrl}}/admin/tenants
{{operatorKey}}
Content-Type: application/json

{
  "slug": "northwind-retail",
  "name": "Northwind Retail",
  "environment": "production",
  "description": "Retail commerce platform. Orders, payments, and stock levels flow out to the ERP, the warehouse, and the analytics lake."
}

###
@northwindId = {{createNorthwind.response.body.$.id}}

###
# Step 4 - Create the active data-plane API key
# @name createNorthwindStorefront
POST {{baseUrl}}/admin/tenants/{{northwindId}}/tenant-api-keys
{{operatorKey}}
Content-Type: application/json

{
  "name": "northwind-storefront",
  "description": "Storefront checkout service. Rotated quarterly.",
  "expires_at": null
}

###
@northwindToken = {{createNorthwindStorefront.response.body.$.token}}

###
# Step 4a - Create a retired key so the dashboard has a revoked credential to show
# @name createNorthwindLegacy
POST {{baseUrl}}/admin/tenants/{{northwindId}}/tenant-api-keys
{{operatorKey}}
Content-Type: application/json

{
  "name": "northwind-legacy-pos",
  "description": "Retired point-of-sale integration.",
  "expires_at": null
}

###
@northwindLegacyKeyId = {{createNorthwindLegacy.response.body.$.tenant_api_key.id}}

###
POST {{baseUrl}}/admin/tenants/{{northwindId}}/tenant-api-keys/{{northwindLegacyKeyId}}/revoke
{{operatorKey}}

###
# Step 5 - Create the Destinations
# @name createNwDestinationErp
POST {{baseUrl}}/admin/tenants/{{northwindId}}/destinations
{{operatorKey}}
Content-Type: application/json

{
  "connector_id": "{{connectorId}}",
  "name": "northwind-erp",
  "configuration": {
    "base_uri": "{{sinkBase}}/sink/northwind-erp"
  },
  "authentication": null,
  "environment": "production",
  "description": "Order and payment records into the ERP."
}

