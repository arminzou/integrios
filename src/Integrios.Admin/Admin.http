###
# Step 9 - Stub the failing Destination so a Delivery dead-letters
POST {{mocksinkAdmin}}/__admin/mappings
Content-Type: application/json

{
  "priority": 1,
  "request": { "method": "POST", "urlPath": "/sink/northwind-billing" },
  "response": { "status": 503, "jsonBody": { "error": "upstream unavailable" } }
}

###
# Step 10 - Drive real traffic through Ingestion
# The warehouse receipt goes over the Service Bus emulator and has no HTTP send here; publish it as
# scripts/seed-dev-data.sh does. No Subscription matches order.cancelled, so it lands unrouted.
POST {{ingestionBaseUrl}}/events?source_id={{createNwSourceOrders.response.body.$.id}}
Authorization: Bearer {{northwindToken}}
Content-Type: application/json

{
  "event_type": "order.placed",
  "source_event_id": "nw-order-1",
  "payload": {
    "orderId": "SO-401",
    "customer": "Contoso Ltd",
    "lines": 1,
    "total": 119.5,
    "currency": "GBP",
    "placedAt": "2026-09-05T09:12:00Z"
  }
}

###
POST {{ingestionBaseUrl}}/events?source_id={{createNwSourceOrders.response.body.$.id}}
Authorization: Bearer {{northwindToken}}
Content-Type: application/json

{
  "event_type": "order.shipped",
  "source_event_id": "nw-ship-1",
  "payload": {
    "orderId": "SO-401",
    "carrier": "Atlas Logistics",
    "tracking": "ATL9911772",
    "warehouse": "LEE-01"
  }
}

###
POST {{ingestionBaseUrl}}/events?source_id={{createNwSourcePayments.response.body.$.id}}
Authorization: Bearer {{northwindToken}}
Content-Type: application/json

{
  "event_type": "payment.captured",
  "source_event_id": "nw-pay-1",
  "payload": {
    "paymentId": "pay_8f21",
    "amount": 119.5,
    "currency": "GBP",
    "method": "card",
    "processor": "stripe"
  }
}

###
POST {{ingestionBaseUrl}}/events?source_id={{createNwSourceInventory.response.body.$.id}}
Authorization: Bearer {{northwindToken}}
Content-Type: application/json

{
  "event_type": "stock.adjusted",
  "source_event_id": "nw-stock-1",
  "payload": {
    "sku": "SKU-771",
    "warehouse": "LEE-01",
    "delta": -1,
    "reason": "pick"
  }
}

###
# Refused with 422 on a top-to-bottom run: the Source's identity rule names a header this request
# does not carry, so no identity can be extracted. That is the exercise. Correct the header through
# Edit, then re-send this request and it is accepted. Until then the webhook-audit Subscription has
# no deliveries, which is what a Source refusing everything looks like from the dashboard.
POST {{ingestionBaseUrl}}/webhooks/{{createNwSourceWebhook.response.body.$.configuration.callback_id}}
X-Storefront-Delivery: nw-webhook-1
Content-Type: application/json

{
  "event_type": "storefront.webhook.received",
  "source_event_id": "nw-webhook-1",
  "payload": {
    "deliveryId": "hook-1",
    "provider": "storefront",
    "result": "accepted"
  }
}

###
# No Subscription matches this: it lands as unrouted, the signal for a missing Subscription.
POST {{ingestionBaseUrl}}/events?source_id={{createNwSourceOrders.response.body.$.id}}
Authorization: Bearer {{northwindToken}}
Content-Type: application/json

{
  "event_type": "order.cancelled",
  "source_event_id": "nw-cancel-1",
  "payload": {
    "orderId": "SO-411",
    "reason": "customer_request"
  }
}
