###
# Admin generates the callback_id in the response for a webhook Source. The identity header below is
# misspelled on purpose, while the webhook request further down carries the correct one: correct the
# Source to X-Storefront-Delivery through Edit, without opening Advanced.
# @name createNwSourceWebhook
POST {{baseUrl}}/admin/tenants/{{northwindId}}/sources
{{operatorKey}}
Content-Type: application/json

{
  "connector_id": "{{connectorId}}",
  "topic_id": "{{createNwTopicStorefrontWebhooks.response.body.$.id}}",
  "name": "Northwind storefront webhooks",
  "type": "webhook",
  "configuration": {},
  "verification": null,
  "input_requirements": {
    "type": "object",
    "properties": {
      "event_type": { "type": "string" }
    },
    "required": ["event_type"],
    "additionalProperties": true
  },
  "mapping": {
    "engine": "jsonata",
    "version": "1",
    "expression": "{ \"event_type\": event_type, \"payload\": payload }"
  },
  "event_identity_rule": {
    "kind": "header",
    "value": "X-Storefront-Delivary",
    "allow_missing": false
  }
}

###
# Creating the broker Source only needs the secret_ref name. The secret file that makes the Worker
# consume the broker is written by scripts/seed-dev-data.sh, not by this file.
# @name createNwSourceBroker
POST {{baseUrl}}/admin/tenants/{{northwindId}}/sources
{{operatorKey}}
Content-Type: application/json

{
  "connector_id": "{{connectorId}}",
  "topic_id": "{{createNwTopicWarehouseReceipts.response.body.$.id}}",
  "name": "Northwind warehouse receipts",
  "type": "broker",
  "configuration": {
    "transport": "azure_service_bus",
    "authentication": {
      "scheme": "connection_string",
      "secret_ref": "dev_service_bus"
    },
    "transport_config": {
      "namespace": "servicebus-emulator",
      "queue_name": "ui-demo"
    }
  },
  "verification": null,
  "input_requirements": null,
  "mapping": null,
  "event_identity_rule": {
    "kind": "message_id",
    "value": "message_id",
    "allow_missing": false
  }
}

###
# Step 8 - Create the Subscriptions
# @name createNwSubscriptionErpOrders
POST {{baseUrl}}/admin/tenants/{{northwindId}}/topics/{{createNwTopicOrders.response.body.$.id}}/subscriptions
{{operatorKey}}
Content-Type: application/json

{
  "name": "erp-orders",
  "match_rules": { "event_type": "order.placed" },
  "destination_id": "{{createNwDestinationErp.response.body.$.id}}",
  "mapping": null,
  "http_delivery": null,
  "http_success": null,
  "order_index": 0,
  "description": "Every placed order into the ERP."
}

