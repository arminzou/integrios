@baseUrl = {{ADMIN_BASE_URL}}
@operatorKey = Authorization: OperatorKey global_operator_key:operator_bootstrap_secret
@webhookIntId = {{applyHttpConnector.response.body.$.id}}

# Sink base URL:
# - use http://mocksink:8080 when calling from one container to another
# - use http://localhost:5054 when driving the stack from your host machine
@sinkBase = {{SINK_BASE}}

###
# Manual flow
#
# Read this file top to bottom. It is a control-plane walkthrough.
#
# Data flow refresher:
# 1. Admin creates tenant-owned config: TenantApiKeys, connections, topics, subscriptions.
# 2. Ingestion accepts events using the tenant API key.
# 3. Topic decides which source connections may publish to that stream.
# 4. Worker reads accepted events, matches subscriptions, applies any transform,
#    and delivers to each destination connection.
# 5. MockSink is the local downstream system so you can watch deliveries happen.

###
# Step 0 - Confirm the control plane is up
GET {{baseUrl}}/health

###
# Step 0a - Auth probe
# Expect 401 because Admin endpoints require the bootstrap operator key.
GET {{baseUrl}}/admin/tenants

###
# Step 1 - Apply the generic HTTP Connector example
# Bootstrap creates only the deployment-wide OperatorKey. Connector identity is generated when
# the Operator applies a manifest through Admin.
# @name applyHttpConnector
PUT {{baseUrl}}/admin/connectors/http/versions/1
{{operatorKey}}
Content-Type: application/json

< ../../examples/connectors/http.json

###
# Step 1a - Inspect the applied HTTP Connector
GET {{baseUrl}}/admin/connectors/{{webhookIntId}}
{{operatorKey}}

###
# Step 2 - Create a tenant
# The tenant is the top-level isolation boundary for all config below.
# @name createTenant
POST {{baseUrl}}/admin/tenants
{{operatorKey}}
Content-Type: application/json

{
  "slug": "acme-corp",
  "name": "Acme Corp",
  "environment": "production",
  "description": "Customer tenant created through the control plane"
}

###
@tenantId = dfc60b3b-7234-48d1-a119-96acb4179e02

# If createTenant returned 409, list tenants, find the existing row, and set
# @tenantId above before continuing.
# @name findTenant
GET {{baseUrl}}/admin/tenants
{{operatorKey}}

###
# Step 2a - Fetch the tenant you will use for the rest of the walkthrough
GET {{baseUrl}}/admin/tenants/{{tenantId}}
{{operatorKey}}

###
# Step 3 - Create a data-plane API key
# Ingestion uses this key to authenticate event writes for this tenant.
# @name createTenantApiKey
POST {{baseUrl}}/admin/tenants/{{tenantId}}/tenant-api-keys
{{operatorKey}}
Content-Type: application/json

{
  "name": "acme-ingestion",
  "description": "Ingestion automation key"
}

###
@tenantApiKeyId = {{createTenantApiKey.response.body.$.tenant_api_key.id}}

# After this request, copy the returned token into:
# src/Integrios.Ingestion/.env
#
# INGESTION_TENANT_API_KEY=<token>

###
# Step 3a - List tenant API keys
GET {{baseUrl}}/admin/tenants/{{tenantId}}/tenant-api-keys
{{operatorKey}}

###
# Step 3b - Fetch the created API key metadata
GET {{baseUrl}}/admin/tenants/{{tenantId}}/tenant-api-keys/{{tenantApiKeyId}}
{{operatorKey}}

###
# Step 4 - Create the source connection
# Source connections represent systems that are allowed to publish into a topic.
# @name createSourceConnection
POST {{baseUrl}}/admin/tenants/{{tenantId}}/connections
{{operatorKey}}
Content-Type: application/json

{
  "connectorId": "{{webhookIntId}}",
  "name": "acme-source",
  "config": {
    "url": "{{sinkBase}}/sink/acme-source"
  },
  "environment": "production",
  "description": "Inbound source connection"
}

###
# Step 4a - Create the destination connection
# Destination connections represent systems the worker may deliver to.
# @name createDestinationConnection
POST {{baseUrl}}/admin/tenants/{{tenantId}}/connections
{{operatorKey}}
Content-Type: application/json

{
  "connectorId": "{{webhookIntId}}",
  "name": "acme-erp",
  "config": {
    "url": "{{sinkBase}}/sink/acme-erp"
  },
  "environment": "production",
  "description": "ERP destination connection"
}

###
@sourceConnectionId = {{createSourceConnection.response.body.$.id}}
@destinationConnectionId = {{createDestinationConnection.response.body.$.id}}

###
# Step 4b - List connections
GET {{baseUrl}}/admin/tenants/{{tenantId}}/connections
{{operatorKey}}

###
# Step 4c - Update the source connection
PATCH {{baseUrl}}/admin/tenants/{{tenantId}}/connections/{{sourceConnectionId}}
{{operatorKey}}
Content-Type: application/json

{
  "name": "acme-source",
  "config": {
    "url": "{{sinkBase}}/sink/acme-source"
  },
  "environment": "production",
  "description": "Inbound source connection (updated)"
}

###
# Step 4d - Update the destination connection
PATCH {{baseUrl}}/admin/tenants/{{tenantId}}/connections/{{destinationConnectionId}}
{{operatorKey}}
Content-Type: application/json

{
  "name": "acme-erp",
  "config": {
    "url": "{{sinkBase}}/sink/acme-erp"
  },
  "environment": "production",
  "description": "ERP destination connection (updated)"
}

###
# Step 5 - Create a topic
# A topic is the named tenant stream. Source connections publish to it.
# @name createTopic
POST {{baseUrl}}/admin/tenants/{{tenantId}}/topics
{{operatorKey}}
Content-Type: application/json

{
  "name": "payments",
  "description": "Payment events stream",
  "sourceConnectionIds": ["{{sourceConnectionId}}"]
}

###
@topicId = {{createTopic.response.body.$.id}}

###
# Step 5a - Fetch the topic
GET {{baseUrl}}/admin/tenants/{{tenantId}}/topics/{{topicId}}
{{operatorKey}}

###
# Step 6 - Create the main subscription
# A subscription is an independent consumer of the topic.
# The worker will create one delivery path per matching subscription.
# @name createSubscription
POST {{baseUrl}}/admin/tenants/{{tenantId}}/topics/{{topicId}}/subscriptions
{{operatorKey}}
Content-Type: application/json

{
  "name": "acme-erp-subscription",
  "matchRules": {
    "event_type": "payment.created"
  },
  "destinationConnectionId": "{{destinationConnectionId}}",
  "orderIndex": 10,
  "description": "ERP sink for created payments"
}

###
@subscriptionId = {{createSubscription.response.body.$.id}}

###
# Step 6a - List subscriptions
GET {{baseUrl}}/admin/tenants/{{tenantId}}/topics/{{topicId}}/subscriptions
{{operatorKey}}

###
# Step 6b - Fetch the created subscription
GET {{baseUrl}}/admin/tenants/{{tenantId}}/topics/{{topicId}}/subscriptions/{{subscriptionId}}
{{operatorKey}}

###
# Step 7 - Preview a transform before saving it
# Binding reminder:
# - the event payload is the JSONata root, so reference `amount`
# - platform metadata lives under `$context`
POST {{baseUrl}}/admin/transform/preview
{{operatorKey}}
Content-Type: application/json

{
  "transform": {
    "engine": "jsonata",
    "version": "1",
    "expression": "{ \"type\": $context.event_type, \"amount\": amount, \"topic\": $context.topic_name }"
  },
  "sampleInput": {
    "amount": 1200,
    "paymentId": "pay_001"
  },
  "sampleContext": {
    "event_type": "payment.created",
    "topic_name": "payments"
  }
}

###
# Step 7a - Save the transform on the subscription
PATCH {{baseUrl}}/admin/tenants/{{tenantId}}/topics/{{topicId}}/subscriptions/{{subscriptionId}}
{{operatorKey}}
Content-Type: application/json

{
  "name": "acme-erp-subscription",
  "matchRules": {
    "event_type": "payment.created"
  },
  "destinationConnectionId": "{{destinationConnectionId}}",
  "transform": {
    "engine": "jsonata",
    "version": "1",
    "expression": "{ \"type\": $context.event_type, \"amount\": amount, \"topic\": $context.topic_name }"
  },
  "orderIndex": 10,
  "description": "ERP sink for created payments (with transform)"
}

###
# Step 7b - Optional: create a second raw subscription
# This lets you compare transformed and raw deliveries for the same event.
# @name createRawSubscription
POST {{baseUrl}}/admin/tenants/{{tenantId}}/topics/{{topicId}}/subscriptions
{{operatorKey}}
Content-Type: application/json

{
  "name": "acme-erp-raw",
  "matchRules": {
    "event_type": "payment.created"
  },
  "destinationConnectionId": "{{destinationConnectionId}}",
  "orderIndex": 20,
  "description": "Raw passthrough subscription (no transform)"
}

###
# Step 7c - Optional: deactivate the raw subscription
POST {{baseUrl}}/admin/tenants/{{tenantId}}/topics/{{topicId}}/subscriptions/{{createRawSubscription.response.body.$.id}}/deactivate
{{operatorKey}}

###
# Step 8 - Cleanup
# Walk backward through the control-plane objects so the next manual run starts
# from a known state. Skip requests for resources you did not create.

###
# Step 8a - Optional: deactivate the raw subscription if it is still active
POST {{baseUrl}}/admin/tenants/{{tenantId}}/topics/{{topicId}}/subscriptions/{{createRawSubscription.response.body.$.id}}/deactivate
{{operatorKey}}

###
# Step 8b - Deactivate the main subscription
POST {{baseUrl}}/admin/tenants/{{tenantId}}/topics/{{topicId}}/subscriptions/{{subscriptionId}}/deactivate
{{operatorKey}}

###
# Step 8c - Deactivate the topic
POST {{baseUrl}}/admin/tenants/{{tenantId}}/topics/{{topicId}}/deactivate
{{operatorKey}}

###
# Step 8d - Deactivate the standard destination connection
POST {{baseUrl}}/admin/tenants/{{tenantId}}/connections/{{destinationConnectionId}}/deactivate
{{operatorKey}}

###
# Step 8e - Deactivate the source connection
POST {{baseUrl}}/admin/tenants/{{tenantId}}/connections/{{sourceConnectionId}}/deactivate
{{operatorKey}}

###
# Step 8f - Revoke the data-plane API key
POST {{baseUrl}}/admin/tenants/{{tenantId}}/tenant-api-keys/{{tenantApiKeyId}}/revoke
{{operatorKey}}

###
# Step 8g - Optional: deactivate the tenant if you want the entire runbook state
# retired instead of reused on the next pass.
POST {{baseUrl}}/admin/tenants/{{tenantId}}/deactivate
{{operatorKey}}
