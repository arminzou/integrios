# This is the one made to fail so a Delivery dead-letters.
# @name createNwDestinationBilling
POST {{baseUrl}}/admin/tenants/{{northwindId}}/destinations
{{operatorKey}}
Content-Type: application/json

{
  "connector_id": "{{connectorId}}",
  "name": "legacy-billing",
  "configuration": {
    "base_uri": "{{sinkBase}}/sink/northwind-billing"
