{{operatorKey}}
Content-Type: application/json

{
  "name": "lake-orders",
  "match_rules": { "event_type": "order.placed" },
  "destination_id": "{{createNwDestinationLake.response.body.$.id}}",
  "mapping": {
    "engine": "jsonata",
    "version": "1",
    "expression": "{ \"order\": orderId, \"total\": total, \"placed_at\": placedAt }"
  },
  "http_delivery": null,
  "http_success": null,
  "order_index": 2,
  "description": "Flattened order feed for the analytics lake."
}

