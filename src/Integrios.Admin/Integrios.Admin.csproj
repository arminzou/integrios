<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Emit the Admin OpenAPI document from the build, so the frontend client is generated from
         the same contract the API serves. Off by default and turned on by the frontend client
         generation step, which supplies placeholder settings instead of running a host. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild Condition="'$(OpenApiGenerateDocumentsOnBuild)' == ''">false</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../artifacts/openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Integrios.FunctionalTests" />
    <InternalsVisibleTo Include="Integrios.Admin.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Integrios.Application\Integrios.Application.csproj" />
    <ProjectReference Include="..\Integrios.Domain\Integrios.Domain.csproj" />
    <ProjectReference Include="..\Integrios.Infrastructure\Integrios.Infrastructure.csproj" />
    <ProjectReference Include="..\Integrios.Migrations.Postgres\Integrios.Migrations.Postgres.csproj" />
    <ProjectReference Include="..\Integrios.Migrations.SqlServer\Integrios.Migrations.SqlServer.csproj" />
  </ItemGroup>

</Project>
