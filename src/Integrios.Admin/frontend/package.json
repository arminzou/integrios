{
  "name": "integrios-admin-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "generate:api": "node scripts/generate-client.mjs",
