    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.11.1",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.9.1",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
