@baseUrl = http://localhost:5231

# Run the Admin.http onboarding flow first to create a tenant and API key.
# Then set this to the token returned by the create API key response.
@apiKeyToken = {{$dotenv INGRESS_API_KEY}}

###
# ── Event intake ──────────────────────────────────────────────────────────────

###
# @name ingest
POST {{baseUrl}}/events
Authorization: ApiKey {{apiKeyToken}}
Content-Type: application/json

{
  "sourceEventId": "event_src_001",
  "topicName": "payments",
  "eventType": "payment.created",
  "payload": { "paymentId": "pay_001", "amount": 1200 },
  "metadata": { "source": "manual-test" },
  "idempotencyKey": "manual-001"
}

###
# Get the accepted event by ID
@eventId = {{ingest.response.body.$.eventId}}

GET {{baseUrl}}/events/{{eventId}}
Authorization: ApiKey {{apiKeyToken}}

###
# Replay a dead-lettered event
POST {{baseUrl}}/events/{{eventId}}/replay
Authorization: ApiKey {{apiKeyToken}}
