<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>Integrios.Client</PackageId>
    <!-- The SDK versions apart from the server; release-please updates the marked line. -->
    <Version>0.2.1</Version> <!-- x-release-please-version -->
    <Description>Consume an Integrios pull Destination from a .NET generic host.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Integrios</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>integrios;webhooks;events;pull-delivery</PackageTags>
    <PackageProjectUrl>https://github.com/arminzou/integrios</PackageProjectUrl>
    <RepositoryUrl>https://github.com/arminzou/integrios</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Integrios.Client.UnitTests" />
  </ItemGroup>

</Project>
