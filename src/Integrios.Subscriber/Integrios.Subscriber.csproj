<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Integrios.Subscriber</PackageId>
    <!-- The SDK versions apart from the server, so it does not take the repository VERSION. -->
    <Version>0.1.0-preview.1</Version>
    <Description>Consume an Integrios pull Destination from a .NET generic host.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Integrios.Subscriber.UnitTests" />
  </ItemGroup>

</Project>
