# Build output and IDE state never belong in the image build context.
**/bin/
**/obj/
.git/
.github/
.vs/
.vscode/

# Source-of-truth and docs are not needed to build runtime images.
dev/
docs/
tests/

# Local environment and secrets.
.env
.env.*
**/*.user

# The dashboard is installed and built inside the image, from the committed lockfile. A host build
# tree would otherwise be copied in and could silently replace what the image build produces.
**/node_modules/
src/Integrios.Admin/wwwroot/
artifacts/
