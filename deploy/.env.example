POSTGRES_USER=integrios
# Set a strong value.
POSTGRES_PASSWORD=change-me

# Image tag to deploy. Left unset on purpose: compose.yml defaults to the release this
# checkout ships, so a fresh clone deploys a matching, known-good version with no edit here.
# Uncomment only to pin a different published release. Never point it at a mutable tag such
# as latest, which tracks unreleased commits on the default branch and would let the three
# services resolve to different digests.
# INTEGRIOS_VERSION=0.2.0

# Secret for the first deployment-wide OperatorKey. Production bootstrap fails closed
# when this is empty. Never set this to the local-development value.
INTEGRIOS_BOOTSTRAP_OPERATOR_KEY_SECRET=

# Absolute HTTPS origin Operators and webhook providers use to reach Ingestion, preserving any
# reverse-proxy path prefix (e.g. https://integrations.example.com/proxy/integrios). Admin uses
# it only to render a source endpoint's absolute callback_url; Ingestion never reads it. Required —
# Admin fails closed without it, and rejects a non-HTTPS value outside Development.
INTEGRIOS_PUBLIC_INGESTION_BASE_URI=

# Worker destination-authentication secret backend. "file" reads
# <tenant-slug>/<reference> below this host directory. Use "configuration" only when
# supplying DestinationSecrets:<tenant>:<reference> through another .NET configuration source.
INTEGRIOS_DESTINATION_SECRETS_PROVIDER=file
INTEGRIOS_DESTINATION_SECRETS_DIR=./secrets/destination

# Ingestion source-verification secret backend. The two child directories are mounted into separate
# processes; never mount the shared parent into either process.
INTEGRIOS_SOURCE_SECRETS_PROVIDER=file
INTEGRIOS_SOURCE_SECRETS_DIR=./secrets/source
