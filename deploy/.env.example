POSTGRES_USER=integrios
# Set a strong value.
POSTGRES_PASSWORD=change-me

# Image tag to deploy; bump deliberately.
INTEGRIOS_VERSION=0.1.0

# Secret for the first global admin key. Leave empty to have bootstrap generate one and
# print it once to the bootstrap container logs. Never set this to the local-dev value.
INTEGRIOS_BOOTSTRAP_ADMIN_SECRET=

# Worker delivery-secret backend. "file" reads <tenant-slug>/<reference> below this
# host directory. Use "configuration" only when supplying Secrets:<tenant>:<reference>
# through another .NET configuration source in your owned deployment.
INTEGRIOS_SECRETS_PROVIDER=file
INTEGRIOS_SECRETS_DIR=./secrets
