# --- Database ---
# Set a strong password.
POSTGRES_USER=integrios
POSTGRES_PASSWORD=change-me

# --- Public address ---
# Absolute HTTPS origin Operators and webhook providers use to reach Ingestion, preserving any
# reverse-proxy path prefix (e.g. https://integrations.example.com/proxy/integrios). Admin uses it
# only to render a source endpoint's absolute callback_url; Ingestion never reads it. Required —
# Admin fails closed without it, and rejects a non-HTTPS value outside Development.
INTEGRIOS_PUBLIC_INGESTION_BASE_URI=

# --- Bootstrap ---
# Secret for the first deployment-wide OperatorKey. Production bootstrap fails closed when this is
# empty. Never set this to the local-development value.
INTEGRIOS_BOOTSTRAP_OPERATOR_KEY_SECRET=

# --- Secret backends ---
# Worker destination-authentication secrets. "file" reads <tenant-slug>/<reference> below this host
# directory. Use "configuration" only when supplying DestinationSecrets:<tenant>:<reference>
# through another .NET configuration source.
INTEGRIOS_DESTINATION_SECRETS_PROVIDER=file
INTEGRIOS_DESTINATION_SECRETS_DIR=./secrets/destination

# Optional destructive completed-history retention. It stays disabled while this is commented.
# Read deploy/README.md before enabling it; the first sweep can permanently remove old history.
# INTEGRIOS_HISTORY_RETENTION_PERIOD=30.00:00:00

# Ingestion source-verification secrets. The two child directories are mounted into separate
# processes; never mount the shared parent into either process.
INTEGRIOS_SOURCE_SECRETS_PROVIDER=file
INTEGRIOS_SOURCE_SECRETS_DIR=./secrets/source

# --- Operator dashboard sign-in ---
# Configure OIDC, enable Integrios-managed password sign-in, or use both. With the Authority empty
# and password disabled, Admin stays machine-only on OperatorKey: the dashboard still loads and
# says no sign-in method is configured, but nobody can sign in. Register the OIDC callback as
# <admin origin>/auth/callback. See docs/operator-dashboard.md.
INTEGRIOS_ADMIN_OIDC_AUTHORITY=
INTEGRIOS_ADMIN_OIDC_CLIENT_ID=
INTEGRIOS_ADMIN_OIDC_CLIENT_SECRET=
INTEGRIOS_ADMIN_OIDC_DISPLAY_NAME=OpenID Connect

# Email and password. This flag only opens the sign-in form; the credential itself is created with
# `operator-user create` through the Admin CLI, which refuses a password from arguments, the
# environment, or configuration. Enabling it before any credential exists grants nobody access.
INTEGRIOS_ADMIN_PASSWORD_ENABLED=false

# --- Release ---
# Image tag to deploy. Left unset on purpose: compose.yml defaults to the release this checkout
# ships, so a fresh clone deploys a matching, known-good version with no edit here. Uncomment only
# to pin a different published release. Never point it at a mutable tag such as latest, which
# tracks unreleased commits on the default branch and would let the three services resolve to
# different digests.
# INTEGRIOS_VERSION=0.5.0

# --- Azure Service Bus credentials ---
# Ambient credential for Queue Sources using the azure_identity scheme. Setting these alone changes
# nothing: the matching lines in compose.yml's ingestion service are commented out and must be
# uncommented too. Prefer a managed identity where the platform offers one (AKS, Container Apps,
# VM) and leave all three unset. The identity needs the "Azure Service Bus Data Receiver" role on
# the namespace; subscription Owner does not grant data-plane access.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- Published ports ---
# The defaults below are what compose.yml already publishes; uncomment one only to move it off a
# port this host has taken. The two service ports carry Operator and webhook-provider traffic and
# are what a reverse proxy points at. The operational ports serve health, readiness, and metrics,
# and bind to 127.0.0.1 only — reach them from the host or a sidecar, never from the network.
# INTEGRIOS_ADMIN_PORT=5150
# INTEGRIOS_ADMIN_OPERATIONAL_PORT=5151
# INTEGRIOS_INGESTION_PORT=5231
# INTEGRIOS_INGESTION_OPERATIONAL_PORT=5232
# INTEGRIOS_WORKER_METRICS_PORT=5299
