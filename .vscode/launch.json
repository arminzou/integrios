{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ingestion",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-integrios",
      "program": "${workspaceFolder}/src/Integrios/bin/Debug/net10.0/integrios.dll",
      "args": ["ingestion"],
      "cwd": "${workspaceFolder}/src/Integrios.Ingestion",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5231"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Admin",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-integrios",
      "program": "${workspaceFolder}/src/Integrios/bin/Debug/net10.0/integrios.dll",
      "args": ["admin"],
      "cwd": "${workspaceFolder}/src/Integrios.Admin",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5150"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Worker",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-integrios",
      "program": "${workspaceFolder}/src/Integrios/bin/Debug/net10.0/integrios.dll",
      "args": ["worker"],
      "cwd": "${workspaceFolder}/src/Integrios.Worker",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Subscriber",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-integrios",
      "program": "${workspaceFolder}/src/Integrios/bin/Debug/net10.0/integrios.dll",
      "args": ["subscriber"],
      "cwd": "${workspaceFolder}/src/Integrios.Subscriber",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5241"
      },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": [
        "Ingestion",
        "Admin",
        "Worker",
        "Subscriber"
      ]
    },
    {
      "name": "Data Plane",
      "configurations": [
        "Ingestion",
        "Worker",
        "Subscriber"
      ]
    }
  ]
}