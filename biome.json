{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "root": true,
  "files": {
    "includes": [
      "src/Integrios.Admin/frontend/**",
      "!**/bin",
      "!**/obj",
      "!**/artifacts",
      "!**/wwwroot",
      "!**/node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
