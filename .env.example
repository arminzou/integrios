# Postgres credentials — used by docker-compose and the Makefile db-* targets
POSTGRES_USER=integrios
POSTGRES_PASSWORD=integrios_dev

# Legacy vars used by the Makefile db-migrate / db-info targets (bare Flyway without compose)
INTEGRIOS_DB_USER=integrios
INTEGRIOS_DB_PASSWORD=integrios_dev

# Selects appsettings.Development.json for the Makefile bootstrap-* targets (dotnet run -- bootstrap ...)
DOTNET_ENVIRONMENT=Development
